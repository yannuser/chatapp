# ───────────────────────── Secrets & environment ─────────────────────────
# Never commit real secrets. Keep a committed template as .env.example instead.
.env
.env.*
!.env.example
!.env.template

# Keys / certificates (RS256 JWT keys, TLS, etc.)
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
*.der
secrets.*
*.secret

# ───────────────────────────── Python ────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging / build artifacts
build/
dist/
*.egg
*.egg-info/
.eggs/

# Test / coverage / type-check caches
.pytest_cache/
.mypy_cache/
.dmypy.json
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.cache/

# ───────────────────────────── Databases ─────────────────────────────────
*.sqlite
*.sqlite3
*.db
dump.rdb

# ─────────────────────────────── Logs ────────────────────────────────────
*.log
logs/

# ──────────────────────────── IDE / editors ──────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─────────────────────────────── OS ──────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
