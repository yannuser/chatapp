# MongoDB
MONGO_URI="mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<AppName>"
MONGO_DB="chatapp"

# JWT (RS256)
# Generate a key pair with:
#   openssl genrsa -out private.pem 2048
#   openssl rsa -in private.pem -pubout -out public.pem
# Then paste the PEM content here, replacing newlines with \n
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n<key>\n-----END PRIVATE KEY-----\n"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n<key>\n-----END PUBLIC KEY-----\n"
JWT_ALGORITHM="RS256"
JWT_ISSUER="chatapp-api"
JWT_AUDIENCE="chatapp-client"
JWT_KEY_ID="local-dev-key"

# Token lifetimes
ACCESS_TOKEN_EXPIRE_MINUTES="15"
REFRESH_TOKEN_EXPIRE_DAYS="7"

# Session middleware
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
SESSION_SECRET_KEY="<random-base64-32-bytes>"

# Redis (set to true to enable token blacklisting on logout)
REDIS_ENABLED="false"
REDIS_HOST="localhost"
REDIS_PORT="6379"
